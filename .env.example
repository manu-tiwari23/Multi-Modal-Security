# =============================================================================
# Multi Modal Security (MMS) — Environment Variables
# =============================================================================
# Copy this file to .env and fill in secret values.
# NEVER commit .env — it's in .gitignore.
# =============================================================================

# -- Redis (Event Bus) -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -- OpenSearch ---------------------------------------------------------------
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_EVENTS_INDEX=mms-events

# -- PostgreSQL ---------------------------------------------------------------
POSTGRES_URL=postgresql://mms:mms_dev_password@localhost:5432/mms

# -- MinIO (Object Storage) --------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mms-evidence

# -- MQTT (Mosquitto) --------------------------------------------------------
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# -- API Gateway --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# Analyst accounts and revocable sessions. Create the first admin using:
# python -m src.auth.cli create admin --role admin
AUTH_STORAGE_MODE=persistent
AUTH_DB_SCHEMA=public
# Set true when serving over HTTPS; false is for local HTTP development.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_SECONDS=28800
AUTH_IDLE_SECONDS=1800
AUTH_LOGIN_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# -- External API Keys (fill these in with real values — never commit them) ---
OPENAI_API_KEY=
COPILOT_MAX_REQUESTS=3
COPILOT_MAX_OUTPUT_TOKENS=700
COPILOT_CONTEXT_BYTES=24000
COPILOT_REQUEST_TIMEOUT_SECONDS=12
COPILOT_TOTAL_TIMEOUT_SECONDS=30
COPILOT_REQUESTS_PER_MINUTE=12
COPILOT_MAX_CONCURRENT=2
VT_API_KEY=
ABUSEIPDB_API_KEY=

# -- Ingestion ----------------------------------------------------------------
RAW_LOGS_DIR=data/raw_logs

# -- Incident Response --------------------------------------------------------
IR_APPROVAL_TTL_SECONDS=3600
IR_FIREWALL_API_URL=mock://firewall.local/api/v1
# Forensic uploads: maximum decoded bytes (default 10 MiB, maximum 100 MiB).
EVIDENCE_MAX_BYTES=10485760
# Persistent forensic storage is the default; memory is explicitly ephemeral.
FORENSICS_STORAGE_MODE=persistent
FORENSICS_DB_SCHEMA=public
MINIO_SECURE=false
STORAGE_TIMEOUT_SECONDS=5
FORENSICS_MAX_ARTIFACT_ROWS=10000
FORENSICS_QUERY_TIMEOUT_SECONDS=3
# Reputation reports are queried externally only on an explicit analyst request.
THREAT_INTEL_CACHE_MODE=persistent
THREAT_INTEL_DB_SCHEMA=public
THREAT_INTEL_CACHE_CAPACITY=5000
THREAT_INTEL_CACHE_TTL_SECONDS=3600
THREAT_INTEL_TIMEOUT_SECONDS=2

# Durable response workflow (gateway migration in progress)
RESPONSE_STORAGE_MODE=persistent
RESPONSE_DB_SCHEMA=public

# Durable correlated incidents and event deduplication
INCIDENT_STORAGE_MODE=persistent
INCIDENT_DB_SCHEMA=public

# Append-only Copilot provenance
COPILOT_AUDIT_MODE=persistent
COPILOT_AUDIT_DB_SCHEMA=public

# Response mode: simulation (default), or firewall_http with a configured adapter
IR_EXECUTION_MODE=simulation
IR_FIREWALL_API_TOKEN=
IR_BACKEND_TIMEOUT_SECONDS=5
