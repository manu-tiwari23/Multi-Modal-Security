# =============================================================================
# Multi Modal Security (MMS) — Environment Variables
# =============================================================================
# Copy this file to .env and fill in secret values.
# NEVER commit .env — it's in .gitignore.
# =============================================================================

# -- Redis (Event Bus) -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -- OpenSearch ---------------------------------------------------------------
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_EVENTS_INDEX=mms-events

# -- PostgreSQL ---------------------------------------------------------------
POSTGRES_URL=postgresql://mms:mms_dev_password@localhost:5432/mms

# -- MinIO (Object Storage) --------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mms-evidence

# -- MQTT (Mosquitto) --------------------------------------------------------
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# -- API Gateway --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# -- External API Keys (fill these in with real values — never commit them) ---
OPENAI_API_KEY=
VT_API_KEY=
ABUSEIPDB_API_KEY=

# -- Ingestion ----------------------------------------------------------------
RAW_LOGS_DIR=data/raw_logs
